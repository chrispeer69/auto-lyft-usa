# Supabase project that receives contact-form submissions.
# Copy this file to `.env` and fill in the values from your Supabase
# dashboard: Project Settings -> API.
#
# The anon key is safe to expose in a browser bundle (it is designed to be
# public and is protected by Row Level Security). The service_role key is NOT
# — never put that in this file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
