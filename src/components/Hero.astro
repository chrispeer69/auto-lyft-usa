---
import PhoneIcon from "./PhoneIcon.astro";
import { COMPANY } from "../data/company";
import type { Photo } from "../data/photos";
interface Props { eyebrow: string; h1: string; lede: string; facts?: [string, string][]; secondary?: { href: string; label: string }; image?: Photo; showTrust?: boolean }
const { eyebrow, h1, lede, facts, secondary = { href: "/request", label: "Request a tow online" }, image, showTrust = true } = Astro.props;
// Only claims the business can stand behind (see CLAUDE.md): no times, ratings or counts.
// In the display font the slash in "24/7" runs into the 7, so it is set at half size.
// "&" is tied to the next word so a line never ends on it.
const h1Parts = h1.replaceAll(" & ", " & ").split(/(24\/7)/);
const trust = ["Open 24/7, 365 days", "Flatbeds + wheel lifts", "Price quoted before dispatch", "Licensed & insured"];
---
<section class={`hero${image ? " has-photo" : ""}`}>
  {image && <img class="hero-bg" src={image.src} srcset={image.srcset} sizes="100vw" alt={image.alt} width="1920" height="1080" fetchpriority="high" decoding="async" />}
  <div class="wrap">
    <div class={`hero-grid${facts?.length ? " has-aside" : ""}`}>
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h1>{h1Parts.map((p) => (p === "24/7" ? <>24<span class="slash">/</span>7</> : p))}</h1>
        <p class="lede">{lede}</p>
        <div class="ctas">
          <a class="btn btn-call" href={COMPANY.telHref}><PhoneIcon /> Call {COMPANY.phone}</a>
          <a class="btn btn-ghost" href={secondary.href}>{secondary.label}</a>
        </div>
        <slot />
      </div>
      {facts?.length ? (
        <aside class="factbox" aria-label="Quick facts">
          <dl>{facts.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}</dl>
        </aside>
      ) : null}
    </div>
    {showTrust && <ul class="trust">{trust.map((t) => <li>{t}</li>)}</ul>}
  </div>
</section>
