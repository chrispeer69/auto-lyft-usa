---
import PhoneIcon from "./PhoneIcon.astro";
import { COMPANY } from "../data/company";
interface Props { eyebrow: string; h1: string; lede: string; facts?: [string, string][]; secondary?: { href: string; label: string } }
const { eyebrow, h1, lede, facts, secondary = { href: "/request", label: "Request a tow online" } } = Astro.props;
---
<section class="hero">
  <div class="wrap">
    <div class={`hero-grid${facts?.length ? " has-aside" : ""}`}>
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h1>{h1}</h1>
        <p class="lede">{lede}</p>
        <div class="ctas">
          <a class="btn btn-call" href={COMPANY.telHref}><PhoneIcon /> Call {COMPANY.phone}</a>
          <a class="btn btn-ghost" href={secondary.href}>{secondary.label}</a>
        </div>
        <slot />
      </div>
      {facts?.length ? (
        <aside class="factbox" aria-label="Quick facts">
          <dl>{facts.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}</dl>
        </aside>
      ) : null}
    </div>
  </div>
</section>
