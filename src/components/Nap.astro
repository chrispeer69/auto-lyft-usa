---
import { COMPANY } from "../data/company";
import { pick } from "../lib/pick";
const { place } = Astro.props as { place?: string };
// Name the page's place when we have one, so local pages don't share this sentence.
const lead = pick(Astro.url.pathname, place
  ? [
      `Trucks are positioned around Columbus, so the closest one heads to ${place}; our yard is ${COMPANY.yardArea}. Dispatch runs ${COMPANY.hours}.`,
      `The trucks that cover ${place} work from spots around the metro, our office is ${COMPANY.yardArea}, and the phone is answered ${COMPANY.hours}.`,
      `Calls from ${place} go to whichever truck is nearest; vehicles we hold are kept at our yard ${COMPANY.yardArea}. Call ${COMPANY.hours}.`,
      `Dispatch for ${place} runs ${COMPANY.hours}, and our yard sits ${COMPANY.yardArea}.`,
    ]
  : [
      `Auto Lyft USA trucks are positioned around Columbus; our yard is ${COMPANY.yardArea}. Dispatch runs ${COMPANY.hours}.`,
      `Our office and yard are ${COMPANY.yardArea}, and the phone is answered ${COMPANY.hours}.`,
      `The nearest truck takes your call, wherever it is parked. Call ${COMPANY.hours}.`,
      `Home base is ${COMPANY.yardArea.replace(/^on /, "")}; dispatch works ${COMPANY.hours}.`,
    ]);
---
<section class="band alt" aria-labelledby="nap-h">
  <div class="wrap cols two">
    <div>
      <h2 id="nap-h">Where the trucks start</h2>
      <p>{lead}</p>
    </div>
    <address class="small">
      <strong>{COMPANY.legalName}</strong><br />
      {COMPANY.address.street}<br />
      {COMPANY.address.city}, {COMPANY.address.region} {COMPANY.address.postal}<br />
      Phone: <a href={COMPANY.telHref}>{COMPANY.phone}</a><br />
      Email: <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a><br />
      <a href={COMPANY.directionsUrl} rel="noopener" target="_blank">Directions to the yard</a>
    </address>
  </div>
</section>
