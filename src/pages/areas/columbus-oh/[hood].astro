---
import Base from "../../../layouts/Base.astro";
import Hero from "../../../components/Hero.astro";
import FaqList from "../../../components/FaqList.astro";
import CtaBand from "../../../components/CtaBand.astro";
import Nap from "../../../components/Nap.astro";
import { HOOD_PAGES, hoodTitle, type Hood } from "../../../data/columbus";
import { hoodBySlug, hoodPath } from "../../../data/columbus/catalog";
import { localPlaceNode, LOCAL_LABELS } from "../../../data/cities";
import { serviceBySlug, servicePath } from "../../../data/services/catalog";
import type { SectionKey } from "../../../data/types";
import { PHOTOS } from "../../../data/photos";
import { serviceNode } from "../../../lib/schema";
import { rich } from "../../../lib/text";
import { highwaysForHood } from "../../../data/highways";
import { highwayPath } from "../../../data/highways/catalog";

export function getStaticPaths() {
  return HOOD_PAGES.map((h) => ({ params: { hood: h.slug }, props: { h } }));
}
const { h } = Astro.props as { h: Hood };
const path = hoodPath(h.slug);
const contains = h.local.map(localPlaceNode).filter((n) => n !== null);
const schema = [
  serviceNode({
    path,
    name: `Towing and roadside help in ${h.name}, Columbus`,
    serviceType: "Towing service",
    description: h.description,
    areaServed: {
      "@type": "Place",
      name: `${h.name}, Columbus, Ohio`,
      containedInPlace: { "@type": "City", name: "Columbus", containedInPlace: { "@type": "State", name: "Ohio" } },
      ...(contains.length ? { containsPlace: contains } : {}),
    },
  }),
];
const kinds = [...new Set(h.local.map((l) => l.kind))];
const next = h.nearby.map((s) => hoodBySlug(s)).filter((n) => n !== undefined);
const picked = h.services.map((s) => serviceBySlug(s)).filter((s) => s !== undefined);
const order: SectionKey[] = h.order ?? ["roads", "local", "faqs", "services"];
const roadsNear = highwaysForHood(h.slug);
const hero = PHOTOS.city;
const shade = (i: number) => (i % 2 === 0 ? "band alt" : "band");
---
<Base
  title={hoodTitle(h.name)}
  description={h.description}
  path={path}
  crumbs={[{ name: "Areas", path: "/areas" }, { name: "Columbus", path: "/areas/columbus-oh" }, { name: h.name, path }]}
  schema={schema}
  faqs={h.faqs}
>
  <Hero image={hero} eyebrow={h.eyebrow} h1={h.h1} lede={h.lede} facts={[["Neighborhood", h.name], ["City", "Columbus, Franklin County"], ["ZIP codes", h.zips.join(", ")], ["Main streets", h.roads.slice(0, 2).map((r) => r.name).join(" · ")]]} />
  <section class="band"><div class="wrap prose">{h.intro.map((p) => <p set:html={rich(p)} />)}</div></section>
  {order.map((key, i) => {
    if (key === "roads") return (
      <section class={shade(i)} aria-labelledby="streets-h">
        <div class="wrap">
          <h2 id="streets-h">{h.headings.roads}</h2>
          <ul class="rules cols two grid">{h.roads.map((r) => <li><h3>{r.name}</h3><p set:html={rich(r.note)} /></li>)}</ul>
        </div>
      </section>
    );
    if (key === "local") return h.local.length > 0 && (
      <section class="band dark" aria-labelledby="local-h">
        <div class="wrap">
          <h2 id="local-h">{h.headings.local}</h2>
          <div class="cols two">
            {kinds.map((k) => (<div><h3>{LOCAL_LABELS[k]}</h3><ul class="rules">{h.local.filter((l) => l.kind === k).map((l) => <li><strong>{l.name}</strong><p set:html={rich(l.detail)} /></li>)}</ul></div>))}
          </div>
        </div>
      </section>
    );
    if (key === "services") return (
      <section class={shade(i)} aria-labelledby="svc-h">
        <div class="wrap">
          <h2 id="svc-h">{h.headings.services}</h2>
          <ul class="linklist">
            {picked.map((s) => <li><a href={servicePath(s.slug)}>{s.name}</a></li>)}
            <li><a href="/towing">All services</a></li>
          </ul>
        </div>
      </section>
    );
    return <section class={shade(i)}><div class="wrap prose"><FaqList faqs={h.faqs} heading={h.headings.faqs} /></div></section>;
  })}
  <CtaBand heading={h.cta.heading} text={h.cta.text} />
  <section class="band alt" aria-labelledby="near-h">
    <div class="wrap">
      <h2 id="near-h">{h.headings.near}</h2>
      <ul class="linklist">
        {next.map((n) => <li><a href={hoodPath(n.slug)}>{n.name}</a></li>)}
        <li><a href="/areas/columbus-oh">All Columbus neighborhoods</a></li>
        <li><a href="/areas">Suburbs and towns</a></li>
      </ul>
      {roadsNear.length > 0 && (
        <>
          <h3 class="mt-28">Highway guides for {h.name}</h3>
          <ul class="linklist">{roadsNear.map((r) => <li><a href={highwayPath(r.slug)}>{r.label}</a></li>)}</ul>
        </>
      )}
    </div>
  </section>
  <Nap place={h.name} heading={h.nap.heading} lead={h.nap.text} />
</Base>
