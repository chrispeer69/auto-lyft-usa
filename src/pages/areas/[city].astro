---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import FaqList from "../../components/FaqList.astro";
import CtaBand from "../../components/CtaBand.astro";
import Nap from "../../components/Nap.astro";
import ServiceCorridorCluster from "../../components/ServiceCorridorCluster.astro";
import { CITIES, cityTitle, localPlaceNode, LOCAL_LABELS, type City } from "../../data/cities";
import { cityBySlug, cityPath } from "../../data/cities/catalog";
import { serviceBySlug, servicePath } from "../../data/services/catalog";
import type { SectionKey } from "../../data/types";
import { PHOTOS } from "../../data/photos";
import { HERO_IMAGES } from "../../data/cities/heroImages";
import { cityPlace, serviceNode } from "../../lib/schema";
import { rich } from "../../lib/text";
import { COMPANY } from "../../data/company";
import { placesForCity } from "../../data/places";
import { placePath } from "../../data/places/catalog";
import { highwaysForCity } from "../../data/highways";
import { highwayPath } from "../../data/highways/catalog";

export function getStaticPaths() {
  return CITIES.map((c) => ({ params: { city: `${c.slug}-oh` }, props: { c } }));
}

const { c } = Astro.props as { c: City };
const path = cityPath(c.slug);
const title = cityTitle(c.name);
const contains = c.local.map(localPlaceNode).filter((n) => n !== null);
const schema = [
  serviceNode({
    path,
    name: `Towing and roadside assistance in ${c.name}, Ohio`,
    serviceType: "Towing service",
    description: c.description,
    areaServed: [
      cityPlace(c.name, c.geo, contains),
      { "@type": "DefinedRegion", name: `${c.name}, OH ZIP codes`, addressCountry: "US", addressRegion: "OH", postalCode: c.zips },
    ],
  }),
];
const kinds = [...new Set(c.local.map((l) => l.kind))];
const venues = placesForCity(c.slug);
const roads = highwaysForCity(c.slug);
const neighbours = c.nearby.map((s) => cityBySlug(s)).filter((n) => n !== undefined);
const picked = c.services.map((s) => serviceBySlug(s)).filter((s) => s !== undefined);
const order: SectionKey[] = c.order ?? ["roads", "local", "services", "faqs"];
const hero = HERO_IMAGES[c.slug] ?? PHOTOS.city;
// Alternate band shading by position, whatever order this page uses.
const shade = (i: number) => (i % 2 === 0 ? "band alt" : "band");
---
<Base
  title={title}
  description={c.description}
  path={path}
  crumbs={[{ name: "Areas", path: "/areas" }, { name: `${c.name}, OH`, path }]}
  schema={schema}
  faqs={c.faqs}
>
  <Hero image={hero}
    eyebrow={c.eyebrow}
    h1={c.h1}
    lede={c.lede}
    facts={[
      ["County", `${c.county} County`],
      ["ZIP codes", c.zips.join(", ")],
      ["Main roads", c.roads.slice(0, 2).map((r) => r.name).join(" · ")],
      ["From our yard", `${c.miles} mi`],
    ]}
  />

  <section class="band">
    <div class="wrap prose">
      {c.intro.map((p) => <p set:html={rich(p)} />)}
    </div>
  </section>

  {order.map((key, i) => {
    if (key === "roads") return (
      <section class={shade(i)} aria-labelledby="roads-h">
        <div class="wrap">
          <h2 id="roads-h">{c.headings.roads}</h2>
          <ul class="rules cols two grid">
            {c.roads.map((r) => <li><h3>{r.name}</h3><p set:html={rich(r.note)} /></li>)}
          </ul>
        </div>
      </section>
    );
    if (key === "services") return (
      <section class={shade(i)} aria-labelledby="svc-h">
        <div class="wrap">
          <h2 id="svc-h">{c.headings.services}</h2>
          <ul class="linklist">
            {picked.map((s) => <li><a href={servicePath(s.slug)}>{s.name}</a></li>)}
            <li><a href="/towing">All services</a></li>
          </ul>
        </div>
      </section>
    );
    if (key === "local") return c.local.length > 0 && (
      <section class="band dark" aria-labelledby="local-h">
        <div class="wrap">
          <h2 id="local-h">{c.headings.local}</h2>
          <div class="cols two">
            {kinds.map((k) => (
              <div>
                <h3>{LOCAL_LABELS[k]}</h3>
                <ul class="rules">
                  {c.local.filter((l) => l.kind === k).map((l) => <li><strong>{l.name}</strong><p set:html={rich(l.detail)} /></li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>
    );
    return (
      <section class={shade(i)}>
        <div class="wrap prose">
          <FaqList faqs={c.faqs} heading={c.headings.faqs} />
        </div>
      </section>
    );
  })}

  <CtaBand heading={c.cta.heading} text={c.cta.text} />

  <section class="band alt" aria-labelledby="near-h">
    <div class="wrap">
      <h2 id="near-h">{c.headings.near}</h2>
      <ul class="linklist">
        {neighbours.map((n) => <li><a href={cityPath(n.slug)}>{n.name}</a></li>)}
        <li><a href="/areas/columbus-oh">Columbus neighborhoods</a></li>
        <li><a href="/areas">Every town we cover</a></li>
      </ul>
      {venues.length > 0 && (<>
        <h3 class="mt-28">Venues and campuses</h3>
        <ul class="linklist">{venues.map((v) => <li><a href={placePath(v.slug)}>{v.label}</a></li>)}</ul>
      </>)}
      {roads.length > 0 && (<>
        <h3 class="mt-28">Highway guides</h3>
        <ul class="linklist">{roads.map((r) => <li><a href={highwayPath(r.slug)}>{r.label}</a></li>)}</ul>
      </>)}
    </div>
  </section>

  <ServiceCorridorCluster compact current={cityPath(c.slug)} heading={`Beyond ${c.name}: our other dispatch corridors`} />
  <Nap place={c.name} heading={c.nap.heading} lead={c.nap.text} />
</Base>
