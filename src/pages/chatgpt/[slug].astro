---
/* ChatGPT ad pages: see src/data/chatgpt.ts. Noindex, no menu (bare), one number. */
import Base from "../../layouts/Base.astro";
import PhoneIcon from "../../components/PhoneIcon.astro";
import { CHATGPT_PAGES, CHATGPT_AREA, CHATGPT_ROADS, chatgptPath, type ChatGptPage } from "../../data/chatgpt";
import { COMPANY, licenceLine } from "../../data/company";

export function getStaticPaths() {
  return CHATGPT_PAGES.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: ChatGptPage };
const licence = licenceLine();
const trust = [
  `Insured through ${COMPANY.insurer}`,
  licence,
  `Local since ${COMPANY.foundingYear}`,
  `${COMPANY.alliance.name} ${COMPANY.alliance.tier} member`,
].filter(Boolean);
---
<Base title={p.title} description={p.description} path={chatgptPath(p.slug)} noindex bare>
  <section class="hero go-hero">
    <div class="wrap">
      <p class="eyebrow">{p.eyebrow} · Columbus, Ohio</p>
      <h1>{p.h1}</h1>
      <p class="lede">{p.sub}</p>
      <div class="ctas"><a class="btn btn-call btn-xl" href={COMPANY.telHref} data-track={`ChatGPT_${p.slug}_hero`}><PhoneIcon /> Call {COMPANY.phone}</a></div>
      <ul class="ticks">{p.ticks.map((t) => <li>✓ {t}</li>)}</ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap gpt-grid">
      <div>
        <h2>What we handle</h2>
        <ul>{p.covers.map((c) => <li>{c}</li>)}</ul>
        <h2>Why drivers call us</h2>
        <ul class="ticks">{trust.map((t) => <li>✓ {t}</li>)}</ul>
        <p class="small muted">Open 24-7 · no hidden fees · cost quoted before dispatch.</p>
      </div>
      <form class="gpt-form" id="gpt-form" data-service={p.service} data-sms={COMPANY.phoneE164}>
        <h2>Rather text than talk?</h2>
        <p class="small muted">Fill in three things and your phone opens a text to dispatch. Nothing is sent until you press send.</p>
        <label>Your name<input name="name" autocomplete="name" required /></label>
        <label>Mobile number<input name="phone" type="tel" autocomplete="tel" required /></label>
        <label>Where are you?<input name="location" placeholder="Address, business, or highway + exit" required /></label>
        <button type="submit" class="btn btn-call">Text my request</button>
        <p class="small muted">Or call <a href={COMPANY.telHref} data-track={`ChatGPT_${p.slug}_form`}>{COMPANY.phone}</a>.</p>
      </form>
    </div>
  </section>

  <section class="band alt">
    <div class="wrap prose">
      <h2>Where we go</h2>
      <p>{CHATGPT_AREA.join(", ")} and the towns around them, plus {CHATGPT_ROADS.slice(0, -1).join(", ")} and {CHATGPT_ROADS.at(-1)}. Trucks start from our yard {COMPANY.yardArea}.</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap prose faq">
      <h2>Straight answers</h2>
      {p.faqs.map((f) => <details><summary><h3>{f.q}</h3></summary><div><p>{f.a}</p></div></details>)}
    </div>
  </section>

  <section class="cta"><div class="wrap"><h2>{COMPANY.name} · 24-7 dispatch</h2><a class="btn btn-call" href={COMPANY.telHref} data-track={`ChatGPT_${p.slug}_footer`}><PhoneIcon /> {COMPANY.phone}</a></div></section>

  <script>
    const f = document.getElementById("gpt-form") as HTMLFormElement | null;
    f?.addEventListener("submit", (e) => {
      e.preventDefault();
      const d = new FormData(f);
      const body = `${f.dataset.service} request from ${location.pathname}. Name: ${d.get("name")}. Phone: ${d.get("phone")}. Location: ${d.get("location")}`;
      const w = window as unknown as { gtag?: (...a: unknown[]) => void };
      w.gtag?.("event", "generate_lead", { method: "chatgpt_text_form", page_path: location.pathname });
      location.href = `sms:${f.dataset.sms}?&body=${encodeURIComponent(body)}`;
    });
  </script>
</Base>

<style>
  .gpt-grid { display: grid; gap: 32px; }
  @media (min-width: 800px) { .gpt-grid { grid-template-columns: 1.2fr 1fr; align-items: start; } }
  .gpt-form { display: grid; gap: 12px; padding: 24px; border: 1px solid var(--line); border-top: 4px solid var(--accent); background: var(--paper); }
  .gpt-form h2 { margin: 0; font-size: 1.3rem; }
  .gpt-form label { display: grid; gap: 4px; font-weight: 600; }
  .gpt-form input { font: inherit; padding: 12px; border: 1px solid var(--line); border-radius: 4px; min-height: 48px; }
</style>
