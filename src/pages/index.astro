---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import { PHOTOS, GROUP_PHOTO } from "../data/photos";
import FaqList from "../components/FaqList.astro";
import CtaBand from "../components/CtaBand.astro";
import Nap from "../components/Nap.astro";
import { HOME, HOME_FAQS } from "../data/home";
import { COMPANY } from "../data/company";
import { SERVICES, SERVICE_GROUPS, servicePath } from "../data/services/catalog";
import { CITY_FACTS, cityPath } from "../data/cities/catalog";

// Towns grouped by compass direction from downtown, so the list reads like a map.
const DOWNTOWN = { lat: 39.9612, lng: -82.9988 };
function direction(lat: number, lng: number): "North" | "East" | "South" | "West" {
  const dy = lat - DOWNTOWN.lat;
  const dx = (lng - DOWNTOWN.lng) * Math.cos((DOWNTOWN.lat * Math.PI) / 180);
  if (Math.abs(dy) >= Math.abs(dx)) return dy >= 0 ? "North" : "South";
  return dx >= 0 ? "East" : "West";
}
const byDir = ["North", "East", "South", "West"].map((d) => ({
  dir: d,
  cities: CITY_FACTS.filter((c) => direction(c.geo.lat, c.geo.lng) === d).sort((a, b) => a.name.localeCompare(b.name)),
}));

const FACTS = [
  { big: "24/7", small: "Live dispatch, every day of the year" },
  { big: `${COMPANY.fleet.trucks}`, small: "Light-duty flatbeds, plus wheel-lift trucks and dollies." },
  { big: `${CITY_FACTS.length}+`, small: "Towns covered across the Columbus metro" },
  { big: "1 call", small: "Location, vehicle, destination. Priced before a truck rolls." },
];
---
<Base title={HOME.title} description={HOME.description} path="/" faqs={HOME_FAQS}>
  <Hero image={PHOTOS.heroDusk}
    eyebrow="Auto Lyft USA · Columbus, Ohio"
    h1={HOME.h1}
    lede={HOME.lede}
    facts={[
      ["Dispatch", "24/7, every day"],
      ["Fleet", "Flatbeds + wheel lifts"],
      ["Yard", "Harrisburg Pike, 43223"],
      ["Coverage", `Columbus + ${CITY_FACTS.length}+ nearby towns`],
    ]}
    showTrust={false}
  >
    <p class="hero-vip"><a href="/vip-program"><strong>VIP Program:</strong> yearly tows and roadside assists from $9/month</a></p>
  </Hero>

  <section class="facts-bar" aria-label="At a glance">
    <div class="wrap">
      <ul>{FACTS.map((f) => <li><strong>{f.big}</strong><span>{f.small}</span></li>)}</ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap split">
      <div class="prose">
        {HOME.intro.map((p) => <p>{p}</p>)}
      </div>
      <figure class="photo"><img src={PHOTOS.yard.src} srcset={PHOTOS.yard.srcset} sizes="(min-width: 900px) 540px, 100vw" alt={PHOTOS.yard.alt} width="1200" height="800" loading="lazy" decoding="async" /></figure>
    </div>
  </section>

  <section class="band alt" aria-labelledby="how-h">
    <div class="wrap">
      <p class="kicker">How a call goes</p>
      <h2 id="how-h">From your phone call to your car on the deck</h2>
      <figure class="photo wide"><img src={PHOTOS.dispatch.src} srcset={PHOTOS.dispatch.srcset} sizes="(min-width: 1200px) 1120px, 100vw" alt={PHOTOS.dispatch.alt} width="1200" height="800" loading="lazy" decoding="async" /></figure>
      <ol class="steps">
        {HOME.steps.map((s) => <li><h3>{s.title}</h3><p>{s.text}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="band" aria-labelledby="svc-h" id="services">
    <div class="wrap">
      <p class="kicker">What we do</p>
      <h2 id="svc-h">Towing and roadside services around Columbus</h2>
      {SERVICE_GROUPS.map((g) => (
        <div class="svc-group">
          <div class="svc-group-head"><img src={GROUP_PHOTO[g.id].small} srcset={GROUP_PHOTO[g.id].srcset} sizes="(min-width: 900px) 300px, 100vw" alt={GROUP_PHOTO[g.id].alt} width="1200" height="800" loading="lazy" decoding="async" /><h3>{g.label}</h3><p>{g.intro}</p></div>
          <ul class="svc-grid">
            {SERVICES.filter((s) => s.group === g.id).map((s) => (
              <li><a class="svc-card" href={servicePath(s.slug)}><strong>{s.name}</strong><span>{s.blurb}</span><em aria-hidden="true">→</em></a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="band dark" aria-labelledby="flat-h">
    <div class="wrap">
      <p class="kicker">Why it matters</p>
      <h2 id="flat-h">Why most Auto Lyft tows ride on a flatbed</h2>
      <ul class="rules cols two grid">
        {HOME.whyFlatbed.map((w) => <li><h3>{w.title}</h3><p>{w.text}</p></li>)}
      </ul>
      <p class="mt-20">Read more on the <a href="/towing/flatbed-towing">flatbed towing page</a>, or see when we use <a href="/towing/wheel-lift-towing">wheel-lift towing</a> instead.</p>
    </div>
  </section>

  <section class="band" aria-labelledby="area-h" id="areas">
    <div class="wrap">
      <p class="kicker">Where we go</p>
      <h2 id="area-h">Columbus and the towns around it</h2>
      <p class="prose">Start with <a href="/areas/columbus-oh">towing in Columbus by neighborhood</a>, or find your town below. Each page lists the ZIP codes, the main roads we work and how far it is from our yard.</p>
      <div class="cols two auto-cols">
        {byDir.map((g) => (
          <div>
            <h3>{g.dir} of downtown</h3>
            <ul class="linklist one-col">
              {g.cities.map((c) => <li><a href={cityPath(c.slug)}>{c.name}</a> <span class="muted small">· {c.miles} mi</span></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />

  <section class="band">
    <div class="wrap prose">
      <FaqList faqs={HOME_FAQS} heading="Columbus towing questions" />
    </div>
  </section>

  <Nap />
</Base>
