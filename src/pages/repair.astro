---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import FaqList from "../components/FaqList.astro";
import CtaBand from "../components/CtaBand.astro";
import Nap from "../components/Nap.astro";
import { REPAIR_PAGES } from "../data/repair";
import { repairPath } from "../data/repair/catalog";
import { REPAIRS } from "../data/repair/catalog";
import { itemListNode } from "../lib/schema";
import type { Faq } from "../data/types";

const path = "/repair";
const faqs: Faq[] = [
  { q: "Does Auto Lyft USA repair cars?", a: "No. We are a towing company. When your car needs a mechanic, we tow it to the shop you choose, or, if you don't have one, to an independent partner shop near you. The shop quotes and does the repair, and you pay them for it." },
  { q: "Can you recommend a mechanic in Columbus?", a: "Yes. Tell the dispatcher what is wrong and roughly where you live or work, and we can suggest a partner shop that handles that kind of repair. You are never required to use one of our suggestions." },
  { q: "Can the shop look at my car before I agree to anything?", a: "Yes. Partner shops diagnose first and call you with a written estimate. Nothing is repaired until you approve it. If you decide not to repair, the car can be towed home or somewhere else; ask for the price of that second trip first." },
  { q: "What if the shop is closed when you arrive?", a: "Many shops have a night-drop box for keys, and we leave the car in their lot with permission. If not, the car stays at our Harrisburg Pike yard overnight and goes over in the morning. Daily storage applies only if it stays longer; see [rates](/rates)." },
];
const list = REPAIR_PAGES.length ? REPAIR_PAGES.map((r) => ({ name: r.name, path: repairPath(r.slug), blurb: r.lede })) : REPAIRS.map((r) => ({ name: r.name, path: repairPath(r.slug), blurb: r.blurb }));
const schema = [itemListNode(path, list)];
---
<Base title="Tow-In Auto Repair Help in Columbus" description="Car needs a mechanic, not just a tow? Auto Lyft USA tows it to your shop or a trusted Columbus partner shop for diagnosis and repair. (614) 633-8163." path={path} pageType={["WebPage", "CollectionPage"]} crumbs={[{ name: "Repair help", path }]} schema={schema} faqs={faqs}>
  <Hero eyebrow="Repair help" h1="Columbus Auto Repair Help That Starts With the Tow" lede="We get the car off the road and into a mechanic's bay. You choose the shop, or we suggest an independent partner shop that does the kind of work your car needs." />
  <section class="band">
    <div class="wrap">
      <h2>Pick the problem</h2>
      <ul class="rules cols two" style="display:grid">{REPAIR_PAGES.map((r) => <li><a href={repairPath(r.slug)}><strong>{r.name}</strong></a><p>{r.lede}</p></li>)}</ul>
    </div>
  </section>
  <CtaBand />
  <section class="band"><div class="wrap prose"><FaqList faqs={faqs} heading="How repair help works" /></div></section>
  <Nap />
</Base>
