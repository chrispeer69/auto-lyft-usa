---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import { PHOTOS } from "../data/photos";
import FaqList from "../components/FaqList.astro";
import CtaBand from "../components/CtaBand.astro";
import Nap from "../components/Nap.astro";
import { SERVICES, SERVICE_GROUPS, servicePath } from "../data/services/catalog";
import { itemListNode } from "../lib/schema";
import type { Faq } from "../data/types";

const path = "/towing";
const faqs: Faq[] = [
  { q: "What towing services does Auto Lyft USA offer in Columbus?", a: `We run ${SERVICES.length} services: emergency and long-distance flatbed tows, battery jumps, door unlocks, spare-tire swaps, gas runs and ditch pulls, plus accounts for fleets, lenders and property managers. Each one has its own page below.` },
  { q: "Which service should I ask for if I am not sure what is wrong?", a: "Just describe what happened: the car won't start, it made a noise and stopped, you hit something. The dispatcher works out whether a [jump start](/towing/jump-start), a [tire change](/towing/flat-tire-change) or a [tow](/towing/emergency-towing) makes sense, and quotes that." },
  { q: "Do roadside calls cost less than a tow?", a: "Usually yes, because the car stays where it is and there are no loaded miles. If the roadside fix doesn't work, the driver can load the car on the spot. The dispatcher tells you both prices up front; see [rates](/rates)." },
  { q: "Do you handle trucks bigger than a pickup?", a: "Our own carriers are light-duty flatbeds. For box trucks, buses and semis we take the call and arrange the job with a heavy-wrecker partner — see [medium-duty](/towing/medium-duty-towing) and [heavy-duty towing](/towing/heavy-duty-towing)." },
];
const schema = [itemListNode(path, SERVICES.map((s) => ({ name: s.name, path: servicePath(s.slug) })))];
---
<Base
  title="Towing & Roadside Services in Columbus"
  description={`All ${SERVICES.length} Auto Lyft USA services in Columbus, OH: flatbed towing, EV transport, jump starts, lockouts, winch-outs and fleet accounts. (614) 633-8163.`}
  path={path}
  pageType={["WebPage", "CollectionPage"]}
  crumbs={[{ name: "Towing services", path }]}
  schema={schema}
  faqs={faqs}
>
  <Hero image={PHOTOS.highway} eyebrow="Services" h1="Every Towing and Roadside Service We Run in Columbus" lede="Pick the one that fits, or just call and describe the problem. The dispatcher matches the job to the right driver and prices it before anyone rolls." />
  {SERVICE_GROUPS.map((g, i) => (
    <section class={`band${i % 2 ? " alt" : ""}`} aria-labelledby={`g-${g.id}`}>
      <div class="wrap">
        <h2 id={`g-${g.id}`}>{g.label}</h2>
        <p class="muted prose flush">{g.intro}</p>
        <ul class="rules cols two grid">
          {SERVICES.filter((s) => s.group === g.id).map((s) => (
            <li><h3><a href={servicePath(s.slug)}>{s.name}</a></h3><p>{s.blurb}</p></li>
          ))}
        </ul>
      </div>
    </section>
  ))}
  <CtaBand />
  <section class="band"><div class="wrap prose"><FaqList faqs={faqs} heading="About our services" /></div></section>
  <Nap />
</Base>
